{
  "id": "home-assistant",
  "activation": {
    "onStartup": true
  },
  "name": "Home Assistant",
  "description": "Call Home Assistant Assist, services, and speaker output from OpenClaw tools.",
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "Home Assistant base URL, such as http://homeassistant.local:8123."
      },
      "accessToken": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "env",
                  "file",
                  "exec"
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "provider",
              "id"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Home Assistant long-lived access token or configured OpenClaw SecretRef."
      },
      "allowedServices": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "description": "Explicit allowlist of Home Assistant services the plugin may call, such as light.turn_on."
      },
      "defaultConversationAgentId": {
        "type": "string",
        "minLength": 1
      },
      "defaultConversationId": {
        "type": "string",
        "minLength": 1
      },
      "defaultSpeakerTarget": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "target": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "messageField": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "service"
        ],
        "additionalProperties": false
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120000
      }
    },
    "additionalProperties": false
  },
  "version": "2026.7.10",
  "contracts": {
    "tools": [
      "home_assistant_assist",
      "home_assistant_call_service",
      "home_assistant_speak"
    ]
  },
  "toolMetadata": {
    "home_assistant_assist": {
      "optional": true
    },
    "home_assistant_call_service": {
      "optional": true
    },
    "home_assistant_speak": {
      "optional": true
    }
  }
}
